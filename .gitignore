# Terraform state files (contain sensitive data)
*.tfstate
*.tfstate.backup

# Local .terraform cache
.terraform/

# Crash log files
crash.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan

# Variable definition files (often contain secrets)
*.tfvars
*.tfvars.json

# Provider binaries (to avoid GitHub large file errors)
.terraform/providers/

# Local environment config files
*.env